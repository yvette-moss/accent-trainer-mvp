# Copy to .env for local development (`npm run dev`). Never commit .env.
# On Vercel, set these under Project → Settings → Environment Variables.

# Required — Azure AI Speech (pronunciation scoring)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Optional — Groq (AI coaching). Without it, built-in phoneme tips are used.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional — extra origins allowed to call /api/* (comma-separated)
# ALLOWED_ORIGINS=https://coach.example.com

# Optional — per-instance rate limits (requests per IP per 10 minutes)
# TOKEN_RATE_LIMIT=30
# COACH_RATE_LIMIT=40
