{
  "name": "Accent Coach — golden dataset",
  "version": "3.0.0",
  "description": "Six benchmark cases that pin down how raw Azure Pronunciation Assessment JSON becomes stars, target-sound gating, word chips, phoneme drifts and coaching decisions. Each case targets an edge case where a plausible implementation gets it wrong. `azure_segments` mirror the real SpeechServiceResponse_JsonResult shape (trimmed to the fields the app reads). Target words and focus sounds come from the exercise in src/phrases.json.",
  "thresholds": {
    "stars": {
      "3": "overall ≥ 85 AND weakest target sound ≥ 80",
      "2": "overall 65–84 (or ≥ 85 with weakest target 65–79)",
      "1": "overall < 65 OR any target-sound failure"
    },
    "target_failure": "target phoneme < 65, heard as another phoneme, or target word skipped/replaced",
    "word_chip": {
      "green": ">=80",
      "amber": "60-79",
      "red": "<60"
    },
    "phoneme_drift": "<60 (any phoneme)"
  },
  "cases": [
